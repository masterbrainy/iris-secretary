# Copy to .env and fill in. NEVER commit .env.
# The service-role / secret key is server-side only — it bypasses Row Level
# Security and must never appear in a client bundle, a prompt, a transcript,
# or a log (CLAUDE.md, Data).

# --- Supabase (local stack prints these on `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- a1mobile -------------------------------------------------------------
# No public developer API exists as of 2026-07-31 (docs/architecture.md §2).
# Every capability is pending and the simulator stands in. These are here so
# the contract is ready if credentials ever land.
A1MOBILE_API_BASE_URL=
A1MOBILE_API_KEY=
A1MOBILE_WEBHOOK_SIGNING_SECRET=

# --- Meta Wearables Device Access Toolkit ---------------------------------
# Requires a Meta Managed Account and per-platform Application IDs
# (docs/meta-wearable-spike.md §2.1). Not yet obtained.
META_WEARABLES_APPLICATION_ID=
META_WEARABLES_CLIENT_TOKEN=

# --- Orchestrator tuning --------------------------------------------------
# Founder has this long to respond before the escalation expires and the
# client receives an honest deferral. Never a fabricated answer.
ESCALATION_TIMEOUT_MS=45000
